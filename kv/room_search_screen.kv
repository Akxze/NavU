#:kivy 2.0
#:import theme navu.theme

<RoomSearchScreen>:
    name: "room_search"
    md_bg_color: theme.PAPER

    MDBoxLayout:
        orientation: "vertical"
        padding: ["18dp", "12dp", "18dp", "16dp"]
        spacing: "10dp"

        # Navy header with a gold back affordance.
        MDCard:
            size_hint_y: None
            height: "56dp"
            padding: ["6dp", "4dp"]
            radius: [18, 18, 18, 18]
            elevation: 2
            theme_bg_color: "Custom"
            md_bg_color: theme.NAVY_900

            MDBoxLayout:
                orientation: "horizontal"
                spacing: "10dp"

                NavButton:
                    style: "tonal"
                    theme_bg_color: "Custom"
                    md_bg_color: theme.NAVY_700
                    size_hint: None, None
                    size: "44dp", "44dp"
                    radius: [22, 22, 22, 22]
                    on_release: app.switch_screen("campus")

                    MDButtonText:
                        text: "‹"
                        font_size: "32sp"
                        theme_text_color: "Custom"
                        text_color: theme.GOLD_300

                MDLabel:
                    text: "Where to?"
                    font_style: "Title"
                    role: "large"
                    bold: True
                    adaptive_height: True
                    pos_hint: {"center_y": 0.5}
                    theme_text_color: "Custom"
                    text_color: theme.WHITE

        # Destination search
        MDBoxLayout:
            orientation: "horizontal"
            adaptive_height: True
            spacing: "8dp"

            MDCard:
                size_hint_x: 0.82
                size_hint_y: None
                height: "54dp"
                padding: ["12dp", "4dp"]
                radius: [27, 27, 27, 27]
                elevation: 1
                theme_bg_color: "Custom"
                md_bg_color: theme.GOLD_500

                MDBoxLayout:
                    orientation: "horizontal"
                    spacing: "8dp"

                    MDIcon:
                        icon: theme.ICON["search"]
                        size_hint: None, 1
                        width: "24dp"
                        theme_text_color: "Custom"
                        text_color: theme.NAVY_900

                    TextInput:
                        id: search_input
                        hint_text: "Search rooms, services, or facilities"
                        hint_text_color: theme.NAVY_600
                        foreground_color: theme.NAVY_900
                        cursor_color: theme.NAVY_900
                        selection_color: theme.alpha(theme.NAVY_900, 0.24)
                        background_normal: ""
                        background_active: ""
                        background_color: 0, 0, 0, 0
                        font_size: "14sp"
                        padding: 0, "14dp", 0, "10dp"
                        multiline: False
                        on_text: root.update_results()

            NavButton:
                style: "filled"
                size_hint_x: 0.18
                theme_bg_color: "Custom"
                md_bg_color: theme.NAVY_800
                size_hint_y: None
                height: "54dp"
                pos_hint: {"center_y": 0.5}
                radius: [27, 27, 27, 27]
                on_release: root.update_results()

                MDButtonText:
                    text: "Go"
                    theme_text_color: "Custom"
                    text_color: theme.GOLD_300

        # Show every supported floor without requiring horizontal scrolling.
        MDGridLayout:
            id: floor_selector
            cols: 4
            size_hint_y: None
            height: "92dp"
            spacing: "6dp"
            row_default_height: "42dp"
            row_force_default: True

            NavButton:
                style: "outlined"
                size_hint_y: None
                height: "42dp"
                theme_bg_color: "Custom"
                md_bg_color: theme.GOLD_500 if root.selected_floor == "LG" else theme.WHITE
                line_color: theme.GOLD_500 if root.selected_floor == "LG" else theme.LINE
                radius: [14, 14, 14, 14]
                on_release: root.select_floor("LG")
                MDButtonText:
                    text: "LG"
                    theme_text_color: "Custom"
                    text_color: theme.NAVY_900

            NavButton:
                style: "outlined"
                size_hint_y: None
                height: "42dp"
                theme_bg_color: "Custom"
                md_bg_color: theme.GOLD_500 if root.selected_floor == "ALL" else theme.WHITE
                line_color: theme.GOLD_500 if root.selected_floor == "ALL" else theme.LINE
                radius: [14, 14, 14, 14]
                on_release: root.select_floor("ALL")
                MDButtonText:
                    text: "All"
                    theme_text_color: "Custom"
                    text_color: theme.NAVY_900

            NavButton:
                style: "outlined"
                size_hint_y: None
                height: "42dp"
                theme_bg_color: "Custom"
                md_bg_color: theme.GOLD_500 if root.selected_floor == "1" else theme.WHITE
                line_color: theme.GOLD_500 if root.selected_floor == "1" else theme.LINE
                radius: [14, 14, 14, 14]
                on_release: root.select_floor("1")
                MDButtonText:
                    text: "1F"
                    theme_text_color: "Custom"
                    text_color: theme.NAVY_900

            NavButton:
                style: "outlined"
                size_hint_y: None
                height: "42dp"
                theme_bg_color: "Custom"
                md_bg_color: theme.GOLD_500 if root.selected_floor == "2" else theme.WHITE
                line_color: theme.GOLD_500 if root.selected_floor == "2" else theme.LINE
                radius: [14, 14, 14, 14]
                on_release: root.select_floor("2")
                MDButtonText:
                    text: "2F"
                    theme_text_color: "Custom"
                    text_color: theme.NAVY_900

            NavButton:
                style: "outlined"
                size_hint_y: None
                height: "42dp"
                theme_bg_color: "Custom"
                md_bg_color: theme.GOLD_500 if root.selected_floor == "3" else theme.WHITE
                line_color: theme.GOLD_500 if root.selected_floor == "3" else theme.LINE
                radius: [14, 14, 14, 14]
                on_release: root.select_floor("3")
                MDButtonText:
                    text: "3F"
                    theme_text_color: "Custom"
                    text_color: theme.NAVY_900

            NavButton:
                style: "outlined"
                size_hint_y: None
                height: "42dp"
                theme_bg_color: "Custom"
                md_bg_color: theme.GOLD_500 if root.selected_floor == "4" else theme.WHITE
                line_color: theme.GOLD_500 if root.selected_floor == "4" else theme.LINE
                radius: [14, 14, 14, 14]
                on_release: root.select_floor("4")
                MDButtonText:
                    text: "4F"
                    theme_text_color: "Custom"
                    text_color: theme.NAVY_900

            NavButton:
                style: "outlined"
                size_hint_y: None
                height: "42dp"
                theme_bg_color: "Custom"
                md_bg_color: theme.GOLD_500 if root.selected_floor == "5" else theme.WHITE
                line_color: theme.GOLD_500 if root.selected_floor == "5" else theme.LINE
                radius: [14, 14, 14, 14]
                on_release: root.select_floor("5")
                MDButtonText:
                    text: "5F"
                    theme_text_color: "Custom"
                    text_color: theme.NAVY_900

        # Results Display Area
        MDCard:
            style: "elevated"
            padding: "10dp"
            radius: [20, 20, 20, 20]
            size_hint: 1, 1
            theme_bg_color: "Custom"
            md_bg_color: theme.PAPER

            RecycleView:
                id: results_list
                viewclass: "RecycledRoomSearchResultCard"
                scroll_type: ["bars", "content"]
                bar_width: "4dp"

                RecycleBoxLayout:
                    default_size: None, "88dp"
                    default_size_hint: 1, None
                    size_hint_y: None
                    height: self.minimum_height
                    orientation: "vertical"
                    spacing: "8dp"

        # Search status
        MDCard:
            style: "elevated"
            padding: ["14dp", "10dp", "14dp", "10dp"]
            size_hint_y: None
            height: "70dp"
            theme_bg_color: "Custom"
            md_bg_color: theme.WHITE
            radius: [18, 18, 18, 18]

            MDBoxLayout:
                orientation: "horizontal"
                spacing: "12dp"

                MDLabel:
                    id: status_label
                    text: "Select a room to view details."
                    halign: "left"
                    valign: "center"
                    font_style: "Body"
                    role: "small"
                    size_hint_x: 1
                    theme_text_color: "Custom"
                    text_color: theme.NAVY_700